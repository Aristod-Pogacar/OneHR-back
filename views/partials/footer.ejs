<script>
  // 1. Obtenir l'élément span par son ID
  var yearElement = document.getElementById('current-year');

  // 2. Vérifier si l'élément existe avant de continuer
  if (yearElement) {
    // 3. Créer un nouvel objet Date pour obtenir l'heure et la date actuelles
    var currentYear = new Date().getFullYear();

    // 4. Mettre à jour le contenu de l'élément span avec l'année actuelle
    yearElement.textContent = currentYear;
  }
</script>

