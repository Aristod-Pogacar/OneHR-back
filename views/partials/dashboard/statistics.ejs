                <%= smiaCountToday %>
              </h1>
            </div>
            <span class="icon widget-icon text-green-500"><i class="mdi mdi-medical-bag mdi-48px"></i></span>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card-content">
          <div class="flex items-center justify-between">
